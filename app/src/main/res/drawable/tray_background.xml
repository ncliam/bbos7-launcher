<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel vuong goc, va vien sang chi chay o canh TREN. Panel rong het man hinh nen
  neu de shape tu ke vien quanh bon canh thi hai canh doc thanh hai vach sang chay
  suot hai ben mep man hinh — <stroke> khong tat rieng tung canh duoc, nen day han
  hai canh do ra ngoai bang inset am.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#E6101418" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
