<?xml version="1.0" encoding="utf-8"?>
<!--
  Mac dinh trong suot, chi phan cach bang hai duong ngang mong.
  Chuyen sang dai xanh gradient khi trackpad focus vao thanh tab.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#3D7BE8"
                        android:centerColor="#2159C9"
                        android:endColor="#143A8F" />
                </shape>
            </item>
            <item android:gravity="top" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#80FFFFFF" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="top" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4DFFFFFF" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
