<?xml version="1.0" encoding="utf-8"?>
<!--
  Chi con dong ho lon va hai icon tran hai ben. Dong nha mang / ngay / chi bao
  da bo: status bar cua Android luon hien nen no lo phan do roi.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFF"
        android:textSize="44sp"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:shadowColor="#CC000000"
        android:shadowDy="2"
        android:shadowRadius="6"
        tools:text="21:55" />

    <ImageView
        android:id="@+id/ringer_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:padding="9dp"
        android:background="@drawable/status_button_background"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/ringer_profile" />

    <ImageView
        android:id="@+id/search_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="10dp"
        android:padding="9dp"
        android:src="@drawable/ic_search"
        android:background="@drawable/status_button_background"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/search_hint" />
</merge>
